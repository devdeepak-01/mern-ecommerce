# =================================================================
# CARA E-COMMERCE BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and adjust the values for your environment.
# =================================================================

# Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas Cluster)
MONGODB_URI=mongodb://localhost:27017/mern-ecommerce

# JSON Web Token (JWT) Secret key for session authentication
JWT_SECRET=your_super_secret_jwt_random_key_string_min_32_characters

# Braintree Sandbox Payment Gateway Credentials (Optional for testing payments)
# Sign up for a free sandbox account at https://www.braintreepayments.com/sandbox
BRAINTREE_MERCHANT_ID=your_braintree_merchant_id_here
BRAINTREE_PUBLIC_KEY=your_braintree_public_key_here
BRAINTREE_PRIVATE_KEY=your_braintree_private_key_here

# Initial SuperAdmin Account Seed Credentials
SUPERADMIN_NAME=Global SuperAdmin
SUPERADMIN_EMAIL=superadmin@cara.test
SUPERADMIN_PASSWORD=superadminPassword123
