# =================================================================
# CARA E-COMMERCE DEMO ENVIRONMENT CONFIGURATION (.env.example)
# =================================================================

# Backend Configuration (backend/.env)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/mern-ecommerce
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars

# Braintree Payment Sandbox (Optional for credit card testing)
BRAINTREE_MERCHANT_ID=your_braintree_merchant_id
BRAINTREE_PUBLIC_KEY=your_braintree_public_key
BRAINTREE_PRIVATE_KEY=your_braintree_private_key

# SuperAdmin Seed Credentials
SUPERADMIN_NAME=Global SuperAdmin
SUPERADMIN_EMAIL=superadmin@cara.test
SUPERADMIN_PASSWORD=superadminPassword123

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000/api
